{
  "name": "willform-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Apps/*",
    "Packages/*",
    "Bridges/Web",
    "Examples/*"
  ],
  "scripts": {
    "dev": "npm -w @willform/workbench run dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run test && npm -w @willform/workbench run build",
    "pack:reference": "node Scripts/pack-reference.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
